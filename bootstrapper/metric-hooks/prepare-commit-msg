#!/usr/bin/env bash
# prepare-commit-msg — Detect AI-generated commits and add origin trailers.
#
# Adds trailers: AI-Origin, AI-Tool, AI-Model, AI-Input-Tokens, AI-Output-Tokens,
# AI-Cost, Spec-Ref, and a compact AI-Summary (base64 JSON) with per-tool breakdown.
#
# Token sources (probed in order, first that returns non-empty wins for the detected tool):
#   1. prism-cli parse-code-tool <tool>  (Claude Code, Cursor, Kiro CLI/IDE, Q Developer)
#   2. codeburn report                   (covers tools without a native parser)
#
# Installation: prism-cli bootstrapper install-git-hooks

set -uo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
SHA="${3:-}"

# Skip merge/squash; never duplicate trailers if user added them manually
if [[ "${COMMIT_SOURCE}" == "merge" || "${COMMIT_SOURCE}" == "squash" ]]; then exit 0; fi
if grep -q '^AI-Origin:' "${COMMIT_MSG_FILE}" 2>/dev/null; then exit 0; fi

# ---------------------------------------------------------------------------
# Detect AI tool involvement
# ---------------------------------------------------------------------------
AI_ORIGIN="human"
AI_MODEL=""
AI_TOOL=""

if [[ -n "${CLAUDE_CODE:-}" || -n "${CLAUDE_CODE_SESSION_ID:-}" ]]; then
    AI_ORIGIN="ai-generated"
    AI_TOOL="claude-code"
    AI_MODEL="${ANTHROPIC_MODEL:-}"
fi

if [[ -n "${KIRO_SESSION_ID:-}" || -n "${KIRO_SESSION:-}" || "${TERM_PROGRAM:-}" == "kiro" \
      || "${VSCODE_GIT_ASKPASS_NODE:-}" == *"kiro"* || "${GIT_ASKPASS:-}" == *"kiro"* ]]; then
    AI_ORIGIN="ai-generated"
    AI_TOOL="kiro"
fi

if [[ -n "${Q_DEVELOPER_SESSION:-}" || "${TERM_PROGRAM:-}" == "amazonq" ]]; then
    AI_ORIGIN="ai-generated"
    AI_TOOL="q-developer"
fi

if [[ -n "${CURSOR_SESSION_ID:-}" || "${TERM_PROGRAM:-}" == "cursor" \
      || "${VSCODE_GIT_ASKPASS_NODE:-}" == *"Cursor"* || "${GIT_ASKPASS:-}" == *"Cursor"* ]]; then
    AI_ORIGIN="ai-generated"
    AI_TOOL="cursor"
fi

# ---------------------------------------------------------------------------
# Detect spec references
# ---------------------------------------------------------------------------
SPEC_REF=""
STAGED_SPECS=$(git diff --cached --name-only 2>/dev/null | grep -E '(specs/|\.kiro/specs/)' | head -1 || true)
[[ -n "${STAGED_SPECS}" ]] && SPEC_REF="${STAGED_SPECS}"
MSG_SPEC=$(grep -oP '(?<=Spec-Ref: ).*' "${COMMIT_MSG_FILE}" 2>/dev/null | head -1 || true)
[[ -n "${MSG_SPEC}" ]] && SPEC_REF="${MSG_SPEC}"

# ---------------------------------------------------------------------------
# Token tracking: query each known tool's native parser, then fall back to codeburn.
# Maintain per-tool snapshot under ~/.prism/tokentracker/<project>/<tool>.json so
# tokens for different tools used on the same project don't clobber each other.
# ---------------------------------------------------------------------------
PROJECT_BASENAME=$(basename "$REPO_ROOT")
TRACKER_DIR="${HOME}/.prism/tokentracker/${PROJECT_BASENAME}"
mkdir -p "${TRACKER_DIR}"

# Probe a tool's native parser, returning JSON on stdout or empty string.
# Additional CLI args may be passed positionally after the tool name.
probe_tool() {
    local tool="$1"; shift
    if ! command -v prism-cli &>/dev/null; then echo ""; return; fi
    prism-cli parse-code-tool "${tool}" --project "${PROJECT_BASENAME}" --format json "$@" 2>/dev/null || echo ""
}

# Probe codeburn (legacy fallback, used when no native parser matches).
probe_codeburn() {
    if ! command -v codeburn &>/dev/null; then echo ""; return; fi
    local PROJECT_FILTER
    PROJECT_FILTER=$(echo "$REPO_ROOT" | sed 's|^/||; s|/|-|g')
    local out
    out=$(codeburn report -p all --project "${PROJECT_FILTER}" --format json 2>/dev/null || echo "")
    if [[ -z "${out}" || "$(echo "${out}" | jq -r '.overview.calls // 0' 2>/dev/null)" == "0" ]]; then
        out=$(codeburn report -p all --project "${PROJECT_BASENAME}" --format json 2>/dev/null || echo "")
    fi
    echo "${out}"
}

# Compute delta against persisted snapshot and update it.
delta_with_snapshot() {
    local tool="$1"
    local json="$2"
    if [[ -z "${json}" ]] || ! command -v jq &>/dev/null; then echo ""; return; fi

    local snapshot="${TRACKER_DIR}/${tool}.json"
    local cur_in cur_out cur_cost
    cur_in=$(echo "${json}" | jq -r '[.models[]?.inputTokens // 0] | add // 0' 2>/dev/null || echo "0")
    cur_out=$(echo "${json}" | jq -r '[.models[]?.outputTokens // 0] | add // 0' 2>/dev/null || echo "0")
    cur_cost=$(echo "${json}" | jq -r '.overview.cost // 0' 2>/dev/null || echo "0")

    local prev_in=0 prev_out=0 prev_cost=0
    if [[ -f "${snapshot}" ]]; then
        prev_in=$(jq -r '.inputTokens // 0' "${snapshot}" 2>/dev/null || echo "0")
        prev_out=$(jq -r '.outputTokens // 0' "${snapshot}" 2>/dev/null || echo "0")
        prev_cost=$(jq -r '.cost // 0' "${snapshot}" 2>/dev/null || echo "0")
    fi

    local d_in=$(( cur_in - prev_in ))
    local d_out=$(( cur_out - prev_out ))
    local d_cost
    d_cost=$(echo "${cur_cost} - ${prev_cost}" | bc 2>/dev/null || echo "0")
    [[ ${d_in} -lt 0 ]] && d_in=0
    [[ ${d_out} -lt 0 ]] && d_out=0
    if (( $(echo "${d_cost} < 0" | bc -l 2>/dev/null) )); then d_cost="0"; fi

    # Capture top model id for this tool (highest output tokens)
    local top_model
    top_model=$(echo "${json}" | jq -r '(.models // []) | sort_by(-.outputTokens) | .[0].name // ""' 2>/dev/null || echo "")

    printf '{"inputTokens":%s,"outputTokens":%s,"cost":%s}\n' "${cur_in}" "${cur_out}" "${cur_cost}" > "${snapshot}"
    # Emit delta as compact JSON for caller
    printf '{"tool":"%s","model":"%s","input":%s,"output":%s,"cost":%s}\n' \
        "${tool}" "${top_model}" "${d_in}" "${d_out}" "${d_cost}"
}

# Collect per-tool deltas. The "primary" tool (from env detection) anchors the
# top-level AI-Tool/AI-Model trailers; every other tool with non-zero tokens
# contributes to the AI-Summary trailer.
DELTAS_JSON="[]"
PRIMARY_DELTA=""

collect_delta() {
    local tool="$1"
    local probe_out="$2"
    local delta
    delta=$(delta_with_snapshot "${tool}" "${probe_out}")
    [[ -z "${delta}" ]] && return
    if command -v jq &>/dev/null; then
        local has_tokens
        has_tokens=$(echo "${delta}" | jq -r '(.input + .output) > 0' 2>/dev/null || echo "false")
        if [[ "${has_tokens}" == "true" ]]; then
            DELTAS_JSON=$(echo "${DELTAS_JSON}" | jq -c --argjson d "${delta}" '. + [$d]')
            if [[ "${tool}" == "${AI_TOOL}" ]]; then
                PRIMARY_DELTA="${delta}"
            fi
        fi
    fi
}

# Always poll all known tools (cheap when the parser finds nothing) — captures the
# case where a developer uses multiple AI tools on the same commit window.
if command -v prism-cli &>/dev/null; then
    collect_delta "claude-code" "$(probe_tool claude-code)"
    collect_delta "cursor"      "$(probe_tool cursor)"
    collect_delta "q-developer" "$(probe_tool q-developer)"
    # Kiro: CLI parser needs session id; IDE parser scans local files
    if [[ -n "${KIRO_SESSION_ID:-}" ]]; then
        collect_delta "kiro" "$(probe_tool kiro-cli --session-id "${KIRO_SESSION_ID}")"
    fi
    collect_delta "kiro" "$(probe_tool kiro-ide)"
fi

# Legacy codeburn fallback — only when no parser found anything AND a tool was detected.
if [[ "${DELTAS_JSON}" == "[]" && -n "${AI_TOOL}" ]]; then
    collect_delta "${AI_TOOL}" "$(probe_codeburn)"
fi

# If the env didn't flag a tool but a parser found usage, upgrade origin.
if [[ "${AI_ORIGIN}" == "human" && "${DELTAS_JSON}" != "[]" ]]; then
    AI_ORIGIN="ai-assisted"
fi

# ---------------------------------------------------------------------------
# Aggregate totals across all tools (this is what the GitHub workflow reads).
# ---------------------------------------------------------------------------
AI_INPUT_TOKENS=""
AI_OUTPUT_TOKENS=""
AI_COST=""
if [[ "${DELTAS_JSON}" != "[]" ]] && command -v jq &>/dev/null; then
    AI_INPUT_TOKENS=$(echo "${DELTAS_JSON}" | jq '[.[].input] | add // 0')
    AI_OUTPUT_TOKENS=$(echo "${DELTAS_JSON}" | jq '[.[].output] | add // 0')
    AI_COST=$(echo "${DELTAS_JSON}" | jq '[.[].cost] | add // 0')
fi

# Anchor top-level model trailer to the primary tool's model (env-detected),
# or fall back to the largest delta's model.
if [[ -z "${AI_MODEL}" ]] && command -v jq &>/dev/null && [[ "${DELTAS_JSON}" != "[]" ]]; then
    AI_MODEL=$(echo "${DELTAS_JSON}" | jq -r 'sort_by(-.output) | .[0].model // ""')
fi
if [[ -z "${AI_TOOL}" ]] && command -v jq &>/dev/null && [[ "${DELTAS_JSON}" != "[]" ]]; then
    AI_TOOL=$(echo "${DELTAS_JSON}" | jq -r 'sort_by(-.output) | .[0].tool // ""')
fi

# ---------------------------------------------------------------------------
# Load configurable bounds from .prism/config.json
# ---------------------------------------------------------------------------
REPO_CONFIG="${REPO_ROOT}/.prism/config.json"
MAX_TOKENS=1000000
MAX_COST=100
if [[ -f "${REPO_CONFIG}" ]] && command -v jq &>/dev/null; then
    MAX_TOKENS=$(jq -r '.max_tokens // 1000000' "${REPO_CONFIG}" 2>/dev/null || echo "1000000")
    MAX_COST=$(jq -r '.max_cost // 100' "${REPO_CONFIG}" 2>/dev/null || echo "100")
fi

# ---------------------------------------------------------------------------
# Append trailers
# ---------------------------------------------------------------------------
if [[ -s "${COMMIT_MSG_FILE}" ]]; then
    LAST_LINE=$(tail -1 "${COMMIT_MSG_FILE}")
    [[ -n "${LAST_LINE}" ]] && echo "" >> "${COMMIT_MSG_FILE}"
fi

echo "AI-Origin: ${AI_ORIGIN}" >> "${COMMIT_MSG_FILE}"
[[ -n "${AI_TOOL}"  ]] && echo "AI-Tool: ${AI_TOOL}"   >> "${COMMIT_MSG_FILE}"
[[ -n "${AI_MODEL}" ]] && echo "AI-Model: ${AI_MODEL}" >> "${COMMIT_MSG_FILE}"

if [[ -n "${AI_INPUT_TOKENS}" ]]; then
    [[ ${AI_INPUT_TOKENS} -gt ${MAX_TOKENS} ]] && AI_INPUT_TOKENS=${MAX_TOKENS}
    echo "AI-Input-Tokens: ${AI_INPUT_TOKENS}" >> "${COMMIT_MSG_FILE}"
fi
if [[ -n "${AI_OUTPUT_TOKENS}" ]]; then
    [[ ${AI_OUTPUT_TOKENS} -gt ${MAX_TOKENS} ]] && AI_OUTPUT_TOKENS=${MAX_TOKENS}
    echo "AI-Output-Tokens: ${AI_OUTPUT_TOKENS}" >> "${COMMIT_MSG_FILE}"
fi
if [[ -n "${AI_COST}" ]]; then
    (( $(echo "${AI_COST} > ${MAX_COST}" | bc -l 2>/dev/null) )) && AI_COST="${MAX_COST}.00"
    AI_COST_FMT=$(printf '%.4f' "${AI_COST}" 2>/dev/null || echo "${AI_COST}")
    echo "AI-Cost: \$${AI_COST_FMT}" >> "${COMMIT_MSG_FILE}"
fi

# Per-tool breakdown — compact base64 JSON so the workflow can attribute
# tokens by tool/model without scanning multiple trailers per commit.
if [[ "${DELTAS_JSON}" != "[]" ]] && command -v base64 &>/dev/null; then
    SUMMARY_B64=$(printf '%s' "${DELTAS_JSON}" | base64 | tr -d '\n')
    # Keep trailer well under git's safe line length (~512 chars)
    if [[ ${#SUMMARY_B64} -lt 4096 ]]; then
        echo "AI-Summary: ${SUMMARY_B64}" >> "${COMMIT_MSG_FILE}"
    fi
fi

[[ -n "${SPEC_REF}" ]] && echo "Spec-Ref: ${SPEC_REF}" >> "${COMMIT_MSG_FILE}"

exit 0
